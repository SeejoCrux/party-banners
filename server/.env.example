# Server Configuration
NODE_ENV=staging
PORT=3001
JWT_SECRET=super-secret-jwt-key-change-this-in-production

# Database & Environment Settings
# Default database path: 'database.sqlite' in dev, 'database-staging.sqlite' in staging, 'database-production.sqlite' in production
DATABASE_PATH=
# Set to 'true' to allow Dev Login in staging/production mode (defaults to false in staging/production)
ENABLE_DEV_LOGIN=false
# Set to 'true' to force seeding mock starter parties (defaults to true in dev, false in staging/production)
SEED_SAMPLE_DATA=false

# Access Control (Comma-separated emails)
SUPER_ADMIN_EMAILS=seejo.crux@gmail.com
ADMIN_EMAILS=admin@example.com

# Google OAuth 2.0 (Required for production authentication when dev login is disabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

